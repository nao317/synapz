generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String    @id @db.Uuid
  email      String
  name       String?
  avatarurl  String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
}
